          "idProducto"
        ],
        "type": "object",
        "properties": {
          "idProducto": {
            "type": "integer",
            "format": "int32"
          },
          "cantidad": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateProductoDto": {
        "required": [
          "codigo",
          "nombre",
          "precio"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "codigo": {
            "minLength": 1,
            "type": "string"
          },
          "fecha_Vencimiento": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "precio": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateProveedorDto": {
        "required": [
          "nombre"
