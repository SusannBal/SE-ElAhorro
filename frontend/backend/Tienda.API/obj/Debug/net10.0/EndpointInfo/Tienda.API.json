          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateUsuarioDto": {
        "required": [
          "contrasena",
          "correo",
          "idRol",
          "nombre",
          "usuario"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 3,
            "type": "string"
          },
          "usuario": {
            "minLength": 4,
            "type": "string"
          },
          "correo": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "contrasena": {
            "minLength": 6,
            "type": "string"
          },
          "idRol": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateVentaDto": {
        "required": [
          "detalles",
          "idUsuario"
        ],
        "type": "object",
        "properties": {
          "idUsuario": {
            "type": "integer",
            "format": "int32"
          },
          "detalles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateDetalleVentaDto"
            }
          }
        },
        "additionalProperties": false
      },
      "IngresoStockDto": {
        "type": "object",
        "properties": {
