        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "telefono": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "relacion": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateRolDto": {
        "required": [
          "nombre"
